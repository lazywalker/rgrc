# apk search: bare name-version-revision lines with optional description (-v flag)
regexp=^(.+)-([^\s-]+)-(r[^\s-]+)( - .+)?$
colours=default,green,dark,bold,default

# apk info <pkg>: "<name>-<ver>-<rev> <field>:" header lines
regexp=^(.+)-([^\s-]+)-(r[^\s-]+) (description|webpage|installed size|depends on|provides|contains|triggers|auto-installed|shared dependencies):$
colours=bold,green,dark,cyan

# apk info -W: "<path> is owned by <name>-<ver>-<rev>"
regexp=^(.+) is owned by (.+)-([^\s-]+)-(r[^\s-]+)$
colours=default,bold,green,dark
