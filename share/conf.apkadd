# Applies to "apk add|del|upgrade"

regexp=^((OK:)|(\d+ errors?;)) (.+) in (.+) packages$
colours=default,default,bold green,bold red,cyan,cyan

# Installing/Upgrading/Purging/etc package
regexp=(\(\s*\d+\/\d+\)) ([^\s]+) ([^\s]+) \(([^\s-]+)-(r[^\s-]+)( -> ([^\s-]+)-(r[^\s-]+))?\)
colours=default,dark,yellow,bold,green,dark,default,green,dark
